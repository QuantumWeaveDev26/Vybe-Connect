# Copy to .env beside server.py. Never share .env or include it in a source ZIP.
# Replace WORKSPACE_ID with the exact uppercase workspace ID from Meta Connection.
# The UI displays your required variable names. No credentials are needed for demo mode.
TW_META_WORKSPACE_ID_TOKEN=
TW_META_WORKSPACE_ID_PHONE_ID=
TW_META_WORKSPACE_ID_WABA_ID=
TW_META_WORKSPACE_ID_APP_SECRET=
TW_META_WORKSPACE_ID_VERIFY_TOKEN=
# Use the Graph API version enabled for your Meta app, e.g. vNN.N.
TW_META_WORKSPACE_ID_VERSION=
# Leave false during development. This gates manual text replies and real queued campaigns.
TW_META_WORKSPACE_ID_LIVE=false
TW_META_WORKSPACE_ID_FLOW_SEND=false

# Sandbox operations are disabled by default. Never use a sandbox database for real clients.
TW_SANDBOX=false

# AI provider: openai or ollama. Credentials remain server-side.
TW_AI_ENABLED=false
TW_AI_PROVIDER=openai
TW_AI_MODEL=gpt-6-luna
# Set locally only. The source ZIP never includes .env.
TW_OPENAI_API_KEY=
# Replace WORKSPACE_ID with the uppercase ID shown in Settings.
# Leave false until you approve paid API usage for that business.
TW_AI_WORKSPACE_ID_ALLOW_PAID=false
# Separate gate for customer-facing automatic WhatsApp replies. Leave false during development.
TW_AI_WORKSPACE_ID_AUTO_REPLY=false
# Optional per-business OpenAI key; overrides the server key for this business.
TW_AI_WORKSPACE_ID_OPENAI_API_KEY=
# Used only when TW_AI_PROVIDER=ollama.
TW_AI_URL=http://127.0.0.1:11434

# Optional allowlisted model picker; only the configured model is exposed by default.
# TW_AI_ALLOWED_MODELS=gpt-6-luna,gpt-6.1-sol
# TW_AI_WORKSPACE_ID_MODELS=gpt-6-luna

# Read-only Shopify connector. Replace WORKSPACE_ID with the uppercase workspace ID.
TW_SHOPIFY_WORKSPACE_ID_SHOP=
TW_SHOPIFY_WORKSPACE_ID_TOKEN=
TW_SHOPIFY_WORKSPACE_ID_API_VERSION=2026-10
TW_SHOPIFY_WORKSPACE_ID_WEBHOOK_SECRET=

# External agents: no dispatch until explicitly enabled for the workspace.
# Replace IDs with their uppercase values from Connection setup.
TW_WEBHOOK_WORKSPACE_ID_ENABLED=false
TW_WEBHOOK_WORKSPACE_ID_ALLOWED_ORIGINS=
TW_WEBHOOK_WORKSPACE_ID_CONNECTION_ID_SECRET=

# Website knowledge: exact public HTTPS origins only; no fetch is allowed by default.
TW_KNOWLEDGE_WEB_WORKSPACE_ID_ALLOWED_ORIGINS=

# Optional email password recovery. Keep disabled until SMTP delivery is approved.
TW_RECOVERY_ENABLED=false
TW_RECOVERY_SECRET=REPLACE_WITH_A_RANDOM_RECOVERY_SECRET
TW_SMTP_HOST=smtp.example.com
TW_SMTP_PORT=465
TW_SMTP_SECURITY=ssl
TW_SMTP_FROM=support@example.com
TW_SMTP_USERNAME=
TW_SMTP_PASSWORD=
# Recovery links use the exact HTTPS TW_PUBLIC_ORIGIN configured above/on the server.
