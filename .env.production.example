# Keep the real copy outside source control and restrict file access.
TW_PUBLIC_ORIGIN=https://chat.example.com
TW_DEPLOYMENT=production
TW_BIND=0.0.0.0
TW_DATA_DIR=/var/lib/teamwave/active
TW_SETUP_TOKEN=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
TW_AI_ENABLED=false
# Enable public business registration only after the platform owner is initialized.
TW_PUBLIC_SIGNUP=false
# Platform-owned Meta app for customer WhatsApp Embedded Signup (not merchant credentials).
TW_META_PLATFORM_ENABLED=false
TW_META_PLATFORM_APP_ID=
TW_META_PLATFORM_CONFIG_ID=
TW_META_PLATFORM_APP_SECRET=
TW_META_PLATFORM_VERIFY_TOKEN=
TW_META_PLATFORM_VERSION=
# Configure the customer credential vault before onboarding customers (see docs/credential-vault.md).
# TW_CREDENTIAL_KEYS is a JSON key-ID map of base64-encoded random 32-byte keys.
# Keep all active/retired keys outside Git and separately from data backups.
TW_CREDENTIAL_KEYS=
TW_CREDENTIAL_ACTIVE_KEY=
# Customer tokens are stored in TW_DATA_DIR/meta-credentials with private file permissions.
# Keep this directory out of source control/public mounts; encrypt host storage and backups.
# Add exact workspace Meta/AI settings only when ready for approved live testing.
# Meta LIVE, FLOW_SEND, AI paid and automatic-reply flags stay false by default.

# Optional email password recovery. Keep disabled until SMTP delivery is approved.
TW_RECOVERY_ENABLED=false
TW_RECOVERY_SECRET=REPLACE_WITH_A_RANDOM_RECOVERY_SECRET
TW_SMTP_HOST=smtp.example.com
TW_SMTP_PORT=465
TW_SMTP_SECURITY=ssl
TW_SMTP_FROM=support@example.com
TW_SMTP_USERNAME=
TW_SMTP_PASSWORD=
# Recovery links use the exact HTTPS TW_PUBLIC_ORIGIN configured above/on the server.

# Optional public, read-only sample workspace. Real owner setup stays protected.
TW_PUBLIC_REVIEW=false

# Operator-controlled client onboarding. Use the actual platform owner's account email.
TW_PLATFORM_OWNER_EMAIL=
# Explicit, read-only provider metadata checks. Does not enable paid transactions.
TW_PROVIDER_READS=false
# Do not enforce billing until an owner account and working subscription are accepted.
TW_BILLING_ENFORCE=false

# Platform subscription account; separate from each merchant's customer payments.
TW_BILLING_KEY_ID=
TW_BILLING_KEY_SECRET=
TW_BILLING_WEBHOOK_SECRET=
TW_BILLING_ACCOUNT_ID=
TW_BILLING_ENABLED=false
TW_BILLING_ALLOW_LIVE=false
# Map plan keys to real Razorpay plans. Prices must match the remote plan exactly.
# Example structure only: {"starter":{"plan_id":"plan_REPLACE","name":"Starter","amount_minor":99900,"currency":"INR","interval":"monthly","cycles":12}}
TW_BILLING_PLANS={}

# Replace WORKSPACE_ID with the exact uppercase business workspace ID.
TW_PAYMENTS_WORKSPACE_ID_KEY_ID=
TW_PAYMENTS_WORKSPACE_ID_KEY_SECRET=
TW_PAYMENTS_WORKSPACE_ID_WEBHOOK_SECRET=
TW_PAYMENTS_WORKSPACE_ID_ACCOUNT_ID=
TW_PAYMENTS_WORKSPACE_ID_ENABLED=false
TW_PAYMENTS_WORKSPACE_ID_ALLOW_LIVE=false

# Shiprocket API token and an existing pickup location. Current workflow: India/INR.
TW_SHIPPING_WORKSPACE_ID_TOKEN=
TW_SHIPPING_WORKSPACE_ID_PICKUP_LOCATION=
TW_SHIPPING_WORKSPACE_ID_PICKUP_POSTCODE=
TW_SHIPPING_WORKSPACE_ID_ENABLED=false

# Inbound WhatsApp Calling API. Requires an eligible number and signed calls webhooks.
TW_CALLING_WORKSPACE_ID_ENABLED=false
TW_CALLING_WORKSPACE_ID_OUTBOUND_ENABLED=false
# Optional coturn REST relay. Shared secret stays server-side; browser credentials expire.
TW_CALLING_WORKSPACE_ID_TURN_URLS=
TW_CALLING_WORKSPACE_ID_TURN_SECRET=

# Messaging, AI and optional connectors (WORKSPACE_ID must be replaced).
TW_META_WORKSPACE_ID_TOKEN=
TW_META_WORKSPACE_ID_PHONE_ID=
TW_META_WORKSPACE_ID_WABA_ID=
TW_META_WORKSPACE_ID_APP_SECRET=
TW_META_WORKSPACE_ID_VERIFY_TOKEN=
TW_META_WORKSPACE_ID_VERSION=
TW_META_WORKSPACE_ID_LIVE=false
TW_META_WORKSPACE_ID_FLOW_SEND=false
TW_SANDBOX=false
TW_AI_PROVIDER=openai
TW_AI_MODEL=gpt-6-luna
TW_OPENAI_API_KEY=
TW_AI_WORKSPACE_ID_ALLOW_PAID=false
TW_AI_WORKSPACE_ID_AUTO_REPLY=false
TW_AI_WORKSPACE_ID_OPENAI_API_KEY=
TW_AI_URL=http://127.0.0.1:11434
TW_SHOPIFY_WORKSPACE_ID_SHOP=
TW_SHOPIFY_WORKSPACE_ID_TOKEN=
TW_SHOPIFY_WORKSPACE_ID_API_VERSION=2026-10
TW_SHOPIFY_WORKSPACE_ID_WEBHOOK_SECRET=
TW_WEBHOOK_WORKSPACE_ID_ENABLED=false
TW_WEBHOOK_WORKSPACE_ID_ALLOWED_ORIGINS=
TW_WEBHOOK_WORKSPACE_ID_CONNECTION_ID_SECRET=
TW_KNOWLEDGE_WEB_WORKSPACE_ID_ALLOWED_ORIGINS=

# Explicit administrator permission can authorize one public knowledge page.
# HTTPS, public DNS pinning, no redirects and content limits remain enforced.
TW_KNOWLEDGE_WEB_SELF_SERVICE=false
